# Local development
SERVER_PORT=8080
APP_ENV=development
DATABASE_URL=postgres://fintrack:fintrack@localhost:5433/fintrack?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_TTL=15m

REDIS_URL=redis://localhost:6379/0

IMPORT_QUEUE_NAME=transaction_import_jobs
IMPORT_UPLOAD_DIR=./var/imports
IMPORT_MAX_FILE_SIZE=5242880
IMPORT_MAX_ROWS=10000
IMPORT_WORKER_CONCURRENCY=2

# false: run cmd/import-worker as a separate process (local default)
# true: API process also runs the Redis import consumer (Render Free)
RUN_IMPORT_WORKER_IN_API=false

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30s
AI_MAX_TOOL_ITERATIONS=5

# Recruiter demo account (credentials remain backend-only)
DEMO_MODE_ENABLED=false
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_AI_DAILY_LIMIT=5

CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Deployment (Render Free web service) — set these in the host dashboard.
# Do not put real secrets in this file.
#
# PORT is injected by Render and takes priority over SERVER_PORT.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
# REDIS_URL=rediss://default:PASSWORD@HOST:6379
# JWT_SECRET=<long random secret>
# RUN_IMPORT_WORKER_IN_API=true
# IMPORT_UPLOAD_DIR=/tmp/fintrack-imports
# CORS_ALLOWED_ORIGINS=https://YOUR-APP.vercel.app
# AI_API_KEY=<backend only, never NEXT_PUBLIC_>
# DEMO_MODE_ENABLED=true
# DEMO_USER_EMAIL=<demo account email>
# DEMO_USER_PASSWORD=<server-only secret>
# DEMO_AI_DAILY_LIMIT=5
# ---------------------------------------------------------------------------
